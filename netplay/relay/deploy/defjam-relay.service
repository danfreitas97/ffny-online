# systemd unit for the Def Jam: Fight for NY netplay relay.
# Install: /etc/systemd/system/defjam-relay.service (see netplay/relay/README.md).
# Check the sandbox with: systemd-analyze security defjam-relay

[Unit]
Description=Def Jam: Fight for NY netplay relay (UDP 27777)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated system user created with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin defjam-relay
User=defjam-relay
Group=defjam-relay
# UDP 27777: the relay. TCP 27778: the launcher's signed update files from /opt/defjam-relay/updates
# (scripts/publish-update.ps1 puts them there; the launcher checks the signature itself).
ExecStart=/opt/defjam-relay/relay -listen :27777 -max-rooms 512 -max-clients 1024 -log-interval 60s -updates-listen :27778 -updates-dir /opt/defjam-relay/updates
Restart=on-failure
RestartSec=2s
# The relay keeps no state on disk and needs no privileges (port > 1024).

# ---- hardening ----
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# A filtered syscall fails with EPERM instead of killing the process.
SystemCallErrorNumber=EPERM
UMask=0077

# ---- resources ----
MemoryMax=128M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
